#!/bin/sh
# Pushing to main auto-deploys to Streamlit Cloud — check the app first.
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 scripts/check.py || {
    echo "pre-push: check failed — push cancelled (bypass with: git push --no-verify)"
    exit 1
}
